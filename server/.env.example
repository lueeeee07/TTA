# Tanzania Tennis Association (TTA) Server Configuration

PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Supabase / Local)
# Supabase format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Local format: postgresql://postgres:postgres@localhost:5432/tta_db
DATABASE_URL=

# SSL Configuration for PostgreSQL (true for Supabase, false for local without SSL)
DATABASE_SSL=true

# Session secret key for admin authentication
SESSION_SECRET=tta-super-secret-session-key-change-in-production

# CORS allowed origins (comma-separated or single)
CORS_ORIGIN=http://localhost:5173,http://localhost:5000,http://localhost:3000
