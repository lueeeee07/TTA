<%- include('includes/header') %>

<div class="page-toolbar">
    <div class="page-toolbar-info">
        <div class="count-pill">
            <i class="fas fa-envelope-open-text text-primary"></i> Total Inquiries: <span><%= messages.length %></span>
        </div>
        <% if (unread > 0) { %>
            <span class="badge bg-danger shadow-sm px-3 py-2">
                <i class="fas fa-circle-exclamation me-1"></i> <%= unread %> Unread Action Required
            </span>
        <% } else { %>
            <span class="badge badge-soft-success px-3 py-2">
                <i class="fas fa-check me-1"></i> All Messages Read
            </span>
        <% } %>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Sender Information</th>
                    <th>Topic</th>
                    <th>Message Excerpt</th>
                    <th>Received At</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            <% messages.forEach(m => { %>
                <tr class="<%= (m.is_read === 1 || m.is_read === true) ? '' : 'bg-warning bg-opacity-10' %>">
                    <td>
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="table-avatar d-flex align-items-center justify-content-center fw-bold <%= (m.is_read === 1 || m.is_read === true) ? 'bg-light text-secondary' : 'bg-primary text-white' %>" style="width: 38px; height: 38px;">
                                <%= m.name.charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <div class="fw-bold text-dark"><%= m.name %></div>
                                <div class="text-muted" style="font-size: 0.78rem;">
                                    <a href="mailto:<%= m.email %>" class="text-decoration-none text-muted">
                                        <%= m.email %>
                                    </a>
                                    <% if (m.phone) { %>
                                        &bull; <span><%= m.phone %></span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge badge-soft-primary"><%= m.topic || 'General' %></span>
                    </td>
                    <td>
                        <div class="text-secondary text-truncate" style="max-width: 280px; font-size: 0.82rem;">
                            <%= m.message %>
                        </div>
                    </td>
                    <td>
                        <div class="text-muted" style="font-size: 0.82rem;">
                            <i class="far fa-clock me-1 text-secondary"></i> <%= new Date(m.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                        </div>
                    </td>
                    <td>
                        <% if (m.is_read === 1 || m.is_read === true) { %>
                            <span class="badge badge-soft-secondary">Read</span>
                        <% } else { %>
                            <span class="badge badge-soft-danger"><i class="fas fa-circle text-danger me-1 fs-xs"></i> New</span>
                        <% } %>
                    </td>
                    <td class="text-end text-nowrap">
                        <button class="btn-action-icon view me-1" data-bs-toggle="modal" data-bs-target="#viewMsg<%= m.id %>" title="Read full message">
                            <i class="fas fa-eye"></i>
                        </button>
                        <form method="POST" class="d-inline">
                            <input type="hidden" name="action" value="toggle_read">
                            <input type="hidden" name="id" value="<%= m.id %>">
                            <button type="submit" class="btn-action-icon edit me-1" title="<%= (m.is_read === 1 || m.is_read === true) ? 'Mark as Unread' : 'Mark as Read' %>">
                                <i class="fas fa-<%= (m.is_read === 1 || m.is_read === true) ? 'envelope' : 'envelope-open' %>"></i>
                            </button>
                        </form>
                        <form method="POST" class="d-inline" onsubmit="return confirm('Delete message from <%= m.name %>?')">
                            <input type="hidden" name="action" value="delete">
                            <input type="hidden" name="id" value="<%= m.id %>">
                            <button class="btn-action-icon delete" title="Delete message">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>

                <!-- Read Message Modal -->
                <div class="modal fade" id="viewMsg<%= m.id %>" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <div class="modal-title-wrap">
                                    <div class="modal-icon-badge">
                                        <i class="fas fa-envelope-open-text"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0">Inquiry Details</h5>
                                        <small class="text-muted"><%= m.topic || 'General Inquiry' %></small>
                                    </div>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="p-3 bg-light rounded-3 mb-3 border">
                                    <div class="row g-2" style="font-size: 0.85rem;">
                                        <div class="col-6">
                                            <strong class="text-dark d-block">From:</strong>
                                            <span><%= m.name %></span>
                                        </div>
                                        <div class="col-6">
                                            <strong class="text-dark d-block">Date:</strong>
                                            <span><%= new Date(m.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                        </div>
                                        <div class="col-6">
                                            <strong class="text-dark d-block">Email:</strong>
                                            <a href="mailto:<%= m.email %>" class="text-primary text-decoration-none"><%= m.email %></a>
                                        </div>
                                        <div class="col-6">
                                            <strong class="text-dark d-block">Phone:</strong>
                                            <span><%= m.phone || 'Not provided' %></span>
                                        </div>
                                    </div>
                                </div>
                                <label class="form-label text-muted">Message Content</label>
                                <div class="p-3 bg-white border rounded-3 text-secondary" style="font-size: 0.92rem; line-height: 1.6; white-space: pre-line;">
                                    <%= m.message %>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <a href="mailto:<%= m.email %>?subject=Re: TTA Inquiry - <%= encodeURIComponent(m.topic || 'Inquiry') %>" class="btn btn-tta">
                                    <i class="fas fa-reply"></i> Reply via Email
                                </a>
                                <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
            <% if (!messages || messages.length === 0) { %>
                <tr>
                    <td colspan="6">
                        <div class="empty-state-box">
                            <div class="empty-state-icon"><i class="fas fa-envelope"></i></div>
                            <div class="empty-state-title">No Messages Received</div>
                            <div class="empty-state-desc">When visitors fill out the contact form on the website, their messages will appear here.</div>
                        </div>
                    </td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('includes/footer') %>
